{
    "path": "/updateOrderInfo",
    "methods": {
        "post": {
            "operationId": "updateOrderInfo",
            "tags": [
                "Entregas"
            ],
            "summary": "Atualizar Informações da Entrega",
            "description": "Permite atualizar informações específicas de uma entrega, como dados de origem, código do pedido e informações de destino (nome, telefone e observações).",
            "parameters": [
                {
                    "$ref": "#/components/parameters/live_mode"
                },
                {
                    "$ref": "#/components/parameters/customer"
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "required": [
                                "logistic_order_tracking",
                                "logistic_subclient_publicID"
                            ],
                            "properties": {
                                "logistic_order_tracking": {
                                    "description": "Código de rastreamento da entrega",
                                    "type": "string",
                                    "example": "ABC123DEF456"
                                },
                                "logistic_subclient_publicID": {
                                    "description": "ID público do subcliente",
                                    "type": "string",
                                    "example": "subclient_123"
                                },
                                "specifications": {
                                    "type": "object",
                                    "description": "Especificações da entrega que podem ser atualizadas",
                                    "properties": {
                                        "orderId": {
                                            "description": "Código do pedido",
                                            "type": "string",
                                            "example": "ORDER_001"
                                        },
                                        "origin": {
                                            "description": "Origem do pedido",
                                            "type": "string",
                                            "example": "E-commerce"
                                        }
                                    }
                                },
                                "addresses": {
                                    "type": "object",
                                    "description": "Informações de endereço para atualização",
                                    "properties": {
                                        "dropoff": {
                                            "type": "object",
                                            "description": "Informações do local de entrega",
                                            "properties": {
                                                "name": {
                                                    "description": "Nome do destinatário",
                                                    "type": "string",
                                                    "example": "João Silva"
                                                },
                                                "phone": {
                                                    "description": "Telefone do destinatário",
                                                    "type": "string",
                                                    "example": "(11) 99999-9999"
                                                },
                                                "obs": {
                                                    "description": "Observações adicionais para o destino",
                                                    "type": "string",
                                                    "example": "Entregar após às 14h"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "type": "object"
                        }
                    }
                }
            },
            "responses": {
                "200": {
                "description": "Requisição processada com sucesso.\n\n**IMPORTANTE:** se o valor do campo 'success' for diferente de `1`, houve um erro na atualização das informações da entrega. Em caso de erro, valide o campo 'message' para mais detalhes.",
                "content": {
                    "application/json": {
                    "schema": {
                        "oneOf": [
                        {
                            "title": "Sucesso",
                            "description": "Informações da entrega atualizadas com sucesso.",
                            "type": "object",
                            "properties": {
                            "success": {
                                "type": "integer",
                                "description": "Indica se a requisição foi processada com sucesso. `1` = Sucesso, qualquer outro valor indica que houve um erro.",
                                "example": 1
                            },
                            "message": {
                                "type": "string",
                                "description": "Mensagem de retorno da solicitação",
                                "example": "Entrega atualizada com sucesso."
                            }
                            }
                        },
                        {
                            "title": "Erro",
                            "description": "Houve um erro na atualização da entrega, valide o campo 'message' para mais detalhes.",
                            "type": "object",
                            "properties": {
                            "success": {
                                "type": "integer",
                                "description": "Indica se a requisição foi processada com sucesso. `1` = Sucesso, qualquer outro valor indica que houve um erro.",
                                "example": 0
                            },
                            "message": {
                                "type": "string",
                                "description": "Mensagem de retorno da solicitação",
                                "example": "Erro ao atualizar a entrega."
                            }
                            }
                        }
                        ]
                    }
                    }
                }
                },
                "400": {
                    "description": "Eroo com validação de dados",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "properties": {
                                        "success": {
                                            "type": "integer",
                                            "example": 0
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Os seguintes campos não são permitidos para edição: addresses.dropoff.name ."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "401": {
                    "$ref": "#/components/responses/401"
                },
                "404": {
                    "$ref": "#/components/responses/404"
                },
                "405": {
                    "$ref": "#/components/responses/405"
                }
            },
            "security": [
                {
                    "TokenQuery": []
                }
            ]
        }
    }
}
